<script>
  export let name: string;
  export let taskId: string;
  export let status: string;
  export let deleteItem: (string) => void;
  export let markDone: (string) => void;
  export let editName: (string, string) => void;

  let isEditing = false;
  let value;

  function edit () {
    if (isEditing) {
      isEditing = false;
      editName(taskId, value);
      return;
    }

    isEditing = true;
  }
</script>

<row>
  {#if status == "done"}
    <text> Task Completed! </text>
  {:else}
    <text> In Progress </text>
  {/if}

  <column id={anotherLayer} on:long_button_id_name_on_button_click>
    {#if isEditing}
      <input value:value={name} />
    {:else}
      <text>
        {#if status == "done"}
          <:s> {name} </:s>
        {:else}
          {name}
        {/if}
      </text>
    {/if}
    <text>(id = {taskId})</text>
    {status}
  </column>

  <button on:on_button_click={edit}>
    {#if isEditing}
      Save
    {:else}
      Edit
    {/if}
  </button>

  <button on:on_button_click={() => deleteItem(taskId)}>
    Delete
  </button>

  <button on:on_button_click={() => markDone(taskId)}>
    Mark Done
  </button>

  <button id={longButtonIdName} on:on_button_click>
    Say Hyalo!
  </button>
</row>
