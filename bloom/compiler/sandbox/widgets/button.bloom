<script>
  let count: number = 1;
</script>

<:button on:click={() => {
  count ++;
  if (count % 2 == 0) {
      textBackground = "black";
  } else {
      textBackground = "blue";
  }
}}>
  <text color:textBackground>
    <slot:counter>
      Counter: {count}
    </slot:counter>

    <slot:header>
      magical!
    </slot:header>
  </text>
</:button>

