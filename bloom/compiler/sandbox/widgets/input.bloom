<script>
  export let value: string = "";

  #event
  function change (event) {
    value = event.target.value;
  }

  #command
  function clear () {
    console.log("Clear command invoked!");
    value = "";
    console.log(inputField);
    inputField.value = "";
  }
</script>

<:input id={inputField} on:change={change} type="text" {value} />
