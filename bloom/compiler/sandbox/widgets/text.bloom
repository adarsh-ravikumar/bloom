<script>
  export let attribThatMustFold: string;
  let value: number;

  function test () {
    console.log("haha normie");
  }

  #event
  function hover () {
    console.log("text hover");
  }

  #event
  function focus () {
    console.log("text focus");
    return value;
  }

  #event
  function longEventName (param1, param2, param3: number, param4: boolean, ...rest) {
    console.log("looooonggg");
  }
</script>

<:div>
  <:button
    on:click={
      (e) => {
        value ++;
        click();
      }
    }

    on:hover={
      (e) => {
        attrib += "a"; 
        hover();
      }
    }
  >
    Click me?
  </:button>

  <:p>
    Hello, world! {attrib}
    {value}
  </:p>
</:div>
