<script>
  let count: number = 1;

  let snapshots = []

</script>

<:h1>
  Counter:  {count}
</:h1>

<:button on:click={() => {
  count ++;
  if (count % 2 == 0) {
      textBackground = "black";
  } else {
      textBackground = "blue";
  }
}}>
  <text color:textBackground>
    <slot:counter>
      Counter: {count}
    </slot:counter>

    <slot:header>
      magical!
    </slot:header>
  </text>
</:button>

<:button on:click={() => snapshots.push(count)}>
 Take Snapshot
</:button>

<:div>
  <:h3>
    Fizz or Buzz?
  </:h3>

    {#if count % 3 == 0 && count % 5 == 0}
      <:h1>FizzBuzz!!</:h1>
      {#if count == 3}
        <:h2>The count is 3</:h2>
      {:elif count == 5}
        <:h2>The count is 5</:h2>
      {/if}
    {:elif count % 3 == 0}
      <:h1>Fizz!</:h1>
      {#if count == 3}
        <:h2>The count is 3</:h2>
      {/if}
    {:elif count % 5 == 0}
      <:h1>Buzz!</:h1>
      {#if count == 5}
        <:h2>The count is 5</:h2>
      {/if}
    {:else}
      <:h1> Neither :( </:h1>
    {/if}
</:div>

<:hr />

<:h3> Snapshots </:h3>

<:ul>
  {#each snapshot {snapshot} in snapshots}
    <:li>
      {snapshot}
    </:li>
  {/each}
</:ul>
