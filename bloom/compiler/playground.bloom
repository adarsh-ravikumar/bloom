<script>
// ============================================================
// GLOBAL STATE
// ============================================================

let count = 0;
let name = "Bloom";
let enabled = true;
let ratio = 1.5;
let message = "hello";
let items = [1, 2, 3];
let config = {
    retries: 3,
    timeout: 1000,
    nested: {
        enabled: true,
    },
};

let globalObject = {
    value: 42,
    name: "global",
};

let maybeValue: number | undefined = 10;

let a = 1;
let b = 2;
let c = 3;

let shadow = "GLOBAL";
let callbackResult = 0;


// ============================================================
// GLOBAL FUNCTIONS
// ============================================================

function increment() {
    count++;
    ratio += 0.5;
    message = `${name}: ${count}`;
    callbackResult = count + a + b + c;

    if (enabled) {
        count += config.retries;
    }

    globalObject.value += count;
}


function decrement() {
    count--;

    if (count > 0) {
        message = "positive";
    } else {
        message = "zero";
    }

    globalObject.value -= ratio;
}


function reset() {
    count = 0;
    ratio = 1;
    message = name;
    callbackResult = config.timeout;

    globalObject.value = 0;
}


function compute(x: number) {
    const result = x * ratio + count;

    callbackResult = result;

    return result;
}


function processItems() {
    for (const item of items) {
        count += item;
        message = `${name}:${item}`;
    }

    return count;
}


function inspectObject() {
    const value = globalObject.value;

    count += value;

    globalObject.name = name;

    return globalObject;
}


function mutateConfig() {
    config.retries++;

    config.timeout += ratio;

    if (config.nested.enabled) {
        message = "nested enabled";
    }

    return config;
}


function conditionalWork() {
    if (enabled && count > 0) {
        message = name;
        count += 1;
    } else if (!enabled || ratio < 0) {
        message = "disabled";
        count -= 1;
    } else {
        message = `fallback:${count}`;
    }

    return count;
}


function shadowTest(count: number) {
    // `count` is LOCAL and must NOT resolve to global count.
    count++;

    {
        let count = 100;

        // This is also local.
        count++;

        message = name;
    }

    // Back to parameter `count`.
    count++;

    // Globals.
    ratio++;
    callbackResult = a + b + c;

    return count;
}


function nestedShadow() {
    let name = "LOCAL NAME";

    {
        let message = "LOCAL MESSAGE";

        count++;

        {
            let count = 999;

            count++;

            // These must still resolve to globals.
            ratio++;
            enabled = !enabled;

            console.log(name);
            console.log(message);
        }

        count++;
    }

    // Global count.
    count++;

    // Local name.
    message = name;
}


function destructuringTest() {
    const {
        value,
        name: localName,
        nested: {
            enabled: nestedEnabled,
        },
    } = globalObject;

    const [first, second, ...rest] = items;

    count += value;
    message = localName;
    enabled = nestedEnabled;

    callbackResult = first + second + rest.length;

    return rest;
}


function assignmentTest() {
    let x = 10;

    x += count;
    x *= ratio;

    globalObject.value = x;

    count = x;
    ratio = count / 2;

    return x;
}


function expressionTest() {
    const x =
        count +
        ratio *
        (a + b) -
        c;

    const y = enabled
        ? message
        : name;

    const z = maybeValue ?? count;

    callbackResult = x;

    return `${y}:${z}:${globalObject.value}`;
}


function memberTest() {
    // `globalObject` is global.
    // `value` is NOT a symbol use.
    const x = globalObject.value;

    // Both globalObject and count are uses.
    globalObject[count] = ratio;

    // `config` is global.
    config.nested.enabled = enabled;

    // Computed property.
    config[message] = count;

    return x;
}


function optionalTest() {
    globalObject?.value;

    config?.nested?.enabled;

    const x = maybeValue?.toString();

    return x ?? message;
}


function callbackTest() {
    const fn = (x: number) => {
        // x is local.
        // Globals remain globals.
        return x + count + ratio;
    };

    callbackResult = fn(a);

    items.forEach((item) => {
        count += item;
        message = `${name}:${item}`;
    });

    return callbackResult;
}


function functionExpressionTest() {
    const fn = function (value: number) {
        // value is local.
        // count/name/ratio are global.
        return value + count + ratio + name.length;
    };

    return fn(a);
}


function defaultParameterTest(
    value: number = count + ratio,
    text: string = message,
) {
    // Parameters shadow nothing here.
    callbackResult = value;

    message = text;

    return value;
}


function restParameterTest(...values: number[]) {
    count += values.length;

    for (const value of values) {
        callbackResult += value;
    }

    return count;
}


function loopTest() {
    for (
        let i = 0;
        i < count;
        i++
    ) {
        ratio += i;

        {
            let ratio = 999;

            // Local ratio.
            callbackResult += ratio;

            // Global count.
            count += 1;
        }

        message = name;
    }

    let key: string;

    for (key in config) {
        message = key;
        count++;
    }

    for (const value of items) {
        count += value;
    }

    while (count < 100) {
        count += 1;
        ratio++;
    }

    do {
        count--;
        message = name;
    } while (count > 50);
}


function switchTest(value: number) {
    switch (value) {
        case 1:
            count++;
            message = name;
            break;

        case 2: {
            let count = 1000;

            count++;

            // Global ratio.
            ratio++;

            break;
        }

        default:
            count += config.retries;
            message = globalObject.name;
    }

    return count;
}


function tryTest() {
    try {
        count++;
        globalObject.value++;
        message = name;
    } catch (error) {
        // error is local to catch.
        message = error instanceof Error
            ? error.message
            : "unknown";

        count--;
    } finally {
        ratio++;
        callbackResult = count;
    }
}


function labeledTest() {
outer: {
        count++;

        for (const item of items) {
            if (item > count) {
                message = name;
                break outer;
            }

            ratio += item;
        }
    }
}


// ============================================================
// CLASS
// ============================================================

class Counter {
    value = count;

    name = name;

    static globalValue = globalObject.value;

    increment() {
        this.value++;

        count++;

        ratio += this.value;

        message = `${this.name}:${count}`;
    }

    decrement() {
        this.value--;

        count--;

        globalObject.value = this.value;

        message = name;
    }

    get current() {
        return this.value + count;
    }

    set current(value: number) {
        this.value = value;

        count = value;

        callbackResult = value;
    }

    static create() {
        count++;

        return new Counter();
    }

    static inspect() {
        return {
            count,
            ratio,
            message,
            objectValue: globalObject.value,
        };
    }
}


// ============================================================
// GLOBAL CLASS USAGE
// ============================================================

function classTest() {
    const counter = new Counter();

    counter.increment();

    count += counter.current;

    counter.current = count;

    const other = Counter.create();

    callbackResult = other.current;

    return Counter.inspect();
}


// ============================================================
// NESTED FUNCTION / CLOSURE TEST
// ============================================================

function closureTest() {
    let local = 10;

    function nested() {
        // `local` is captured, therefore NOT global.
        local++;

        // These ARE global.
        count++;
        ratio += local;
        message = name;
    }

    nested();

    return local;
}


// ============================================================
// HEAVY MIXED FUNCTION
// ============================================================

function everything(
    input: number = count,
    ...values: number[]
) {
    let local = input;

    {
        let shadow = "LOCAL";

        local += count;
        local += ratio;

        if (enabled) {
            message = shadow;
        } else {
            message = name;
        }
    }

    for (const value of values) {
        local += value;
        count += value;
    }

    const result = {
        count,
        ratio,
        name,
        message,
        enabled,
        value: globalObject.value,
        computed: config[message],
    };

    callbackResult = result.count;

    return result;
}


// ============================================================
// TOP LEVEL USES
// ============================================================

count++;
ratio = compute(count);

message = name;

if (enabled) {
    increment();
} else {
    decrement();
}

const result = everything(
    count,
    a,
    b,
    c,
);

globalObject.value = result.count;

callbackResult = processItems();

console.log(
    count,
    name,
    ratio,
    message,
    globalObject.value,
    callbackResult,
);

</script>

<vstack>
  <text>Count: {count}</text>
  {#if count_is_even()}
    <text>Is Even</text>
  {:elif count_is_odd()}
    <text>Is Odd</text>
  {:else}
    <text>Neither odd or even? or did is_odd not work?</text>
  {/if}
  <button> increment_count(1)}}>Increment!</button>
</vstack>

