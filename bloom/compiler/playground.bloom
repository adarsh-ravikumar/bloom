<script>
    type UserId = string;
    type UserName = string;
    type Score = number;
    type Enabled = boolean;
    type UserTags = string[];
    type ScorePair = [Score, Score];
    type StatusValue = "active" | "pending" | "disabled";

    interface User {
        id: UserId;
        name: UserName;
        score: Score;
        enabled: Enabled;
        tags: UserTags;
    }

    interface Config {
        maxScore: Score;
        enabled: Enabled;
    }

    interface Result {
        value: Score;
        user: User;
    }

    interface NestedResult {
        result: Result;
        pair: ScorePair;
    }

    enum UserStatus {
        Active,
        Pending,
        Disabled,
    }

    enum Priority {
        Low = 1,
        Medium = 2,
        High = 3,
    }


    let user: User;
    let item: User;
    let category: UserName;
    let score: Score;
    let enabled: Enabled;
    let status: UserStatus;
    let priority: Priority;

    let users: User[];
    let items: User[];
    let categories: UserName[];

    let pair: ScorePair;
    let config: Config;
    let result: Result;
    let nested: NestedResult;


    // ============================================================
    // DIRECTIVE FUNCTIONS
    // ============================================================

    #event
    function onUserSelected(selected: User): void {
        let score: Score = selected.score;

        user.name;
        selected.name;
        score;
        status;
        priority;
        config.enabled;
    }


    #command
    function updateUser(
        user: User,
        score: Score,
    ): Result {
        user.name;
        score;
        result.value;
        config.maxScore;

        return result;
    }


    #reactive
    function calculateScore(
        item: User,
    ): Score {
        item.score;
        user.score;
        score;
        pair[0];
        pair[1];

        return item.score + score;
    }


    // ============================================================
    // DIRECTIVE FUNCTIONS WITH NESTED TYPES
    // ============================================================

    #command
    function processUser(user: User): Result {

        type LocalScore = number;

        interface LocalResult {
            score: LocalScore;
            user: User;
        }

        let score: LocalScore;

        user.name;
        score;
        result.value;
        config.maxScore;

        return result;
    }


    #reactive
    function deriveUser(item: User): Score {

        type ScoreValue = Score;

        interface ScoreRecord {
            value: ScoreValue;
            user: User;
        }

        let record: ScoreRecord;

        item.score;
        record.value;
        record.user.name;
        score;

        return item.score;
    }


    #event
    function onPriorityChanged(
        priority: Priority,
    ): void {

        priority;
        status;
        user.name;
        config.enabled;
        result.user.name;
    }


    // ============================================================
    // NESTED FUNCTIONS INSIDE DIRECTIVE FUNCTIONS
    // ============================================================

    #command
    function deeplyNested(user: User): Result {

        let score: Score;

        function inner(item: User): Result {

            type UserName = number;

            interface User {
                id: UserId;
                name: UserName;
                score: Score;
            }

            user.name;
            item.name;
            score;
            result.user.name;

            function deepest(user: User): Result {
                user.name;
                item.name;
                score;
                result.user.name;

                return result;
            }

            return deepest(item);
        }

        return inner(user);
    }
</script>


<page>

    <!-- ========================================================= -->
    <!-- 1. PLAIN EACH                                             -->
    <!-- ========================================================= -->

    {#each users in users}

        <panel>
            <text>{users.length}</text>
            <text>{user.name}</text>
            <text>{score}</text>
            <text>{category}</text>
            <text>{enabled}</text>
        </panel>

    {/each}


    <!-- ========================================================= -->
    <!-- 2. SIMPLE VALUE SHADOWING                                 -->
    <!-- ========================================================= -->

    {#each user in users}

        <panel>
            <text>{user.name}</text>
            <text>{user.score}</text>

            <!-- global -->
            <text>{score}</text>

            <!-- local user + global score -->
            <text>{user.score + score}</text>

            <text>{describe(user)}</text>
            <text>{getScore()}</text>
        </panel>

    {/each}


    <!-- ========================================================= -->
    <!-- 3. OUTER DOES NOT SHADOW, INNER DOES                      -->
    <!-- ========================================================= -->

    {#each category in categories}

        <panel>

            <text>{category}</text>
            <text>{user.name}</text>
            <text>{score}</text>

            {#each item in items}

                <panel>

                    <text>{category}</text>
                    <text>{item.name}</text>
                    <text>{user.name}</text>
                    <text>{score}</text>

                    {#each user in users}

                        <panel>

                            <!-- inner user -->
                            <text>{user.name}</text>

                            <!-- middle item -->
                            <text>{item.name}</text>

                            <!-- outer category -->
                            <text>{category}</text>

                            <!-- global score -->
                            <text>{score}</text>

                            <text>
                                {user.score + item.score + score}
                            </text>

                            <text>
                                {describe(user)}
                            </text>

                        </panel>

                    {/each}

                </panel>

            {/each}

        </panel>

    {/each}


    <!-- ========================================================= -->
    <!-- 4. THREE LEVELS OF SHADOWING                              -->
    <!-- ========================================================= -->

    {#each user in users}

        <panel>

            <text>{user.name}</text>

            {#each item in items}

                <panel>

                    <text>{user.name}</text>
                    <text>{item.name}</text>

                    {#each score in items}

                        <panel>

                            <!-- score = inner context -->
                            <text>{score.name}</text>

                            <!-- item = middle context -->
                            <text>{item.name}</text>

                            <!-- user = outer context -->
                            <text>{user.name}</text>

                            <!-- category = global -->
                            <text>{category}</text>

                            <text>{score.score + item.score}</text>

                        </panel>

                    {/each}

                    <!-- score goes back to global -->
                    <text>{score}</text>

                </panel>

            {/each}

            <text>{user.name}</text>

        </panel>

    {/each}


    <!-- ========================================================= -->
    <!-- 5. IF / ELIF / ELSE INSIDE EACH                          -->
    <!-- ========================================================= -->

    {#each item in items}

        {#if item.score > score}

            <text>{item.name}</text>
            <text>{item.score}</text>
            <text>{score}</text>

        {:elif item.score === score}

            <text>{item.name}</text>
            <text>{score}</text>

        {:else}

            <text>{item.name}</text>
            <text>{score}</text>

        {/if}

    {/each}


    <!-- ========================================================= -->
    <!-- 6. NESTED EACH + IF + SHADOWING                          -->
    <!-- ========================================================= -->

    {#each user in users}

        {#if user.enabled}

            {#each item in items}

                {#if item.score > user.score}

                    <text>{user.name}</text>
                    <text>{item.name}</text>
                    <text>{user.score}</text>
                    <text>{item.score}</text>

                {:elif item.score === user.score}

                    <text>{user.name}</text>
                    <text>{item.name}</text>

                {:else}

                    <text>{user.name}</text>
                    <text>{item.name}</text>
                    <text>{score}</text>

                {/if}

            {/each}

        {:else}

            <text>{user.name}</text>
            <text>{enabled}</text>

        {/if}

    {/each}


    <!-- ========================================================= -->
    <!-- 7. SAME NAME AT FOUR DIFFERENT LEVELS                    -->
    <!-- ========================================================= -->

    {#each user in users}

        <text>{user.name}</text>

        {#each user in users}

            <text>{user.name}</text>

            {#each user in users}

                <text>{user.name}</text>

                {#each user in users}

                    <text>{user.name}</text>
                    <text>{score}</text>

                {/each}

                <text>{user.name}</text>

            {/each}

            <text>{user.name}</text>

        {/each}

        <text>{user.name}</text>

    {/each}


    <!-- ========================================================= -->
    <!-- 8. DIFFERENT NAMES, SAME DEPTH                           -->
    <!-- ========================================================= -->

    {#each user in users}

        {#each item in items}

            {#each category in categories}

                <text>{user.name}</text>
                <text>{item.name}</text>
                <text>{category}</text>

                <text>{score}</text>
                <text>{enabled}</text>
                <text>{status}</text>

                <text>
                    {compare(user.score, item.score)}
                </text>

            {/each}

        {/each}

    {/each}


    <!-- ========================================================= -->
    <!-- 9. TYPE-HEAVY EXPRESSIONS                                -->
    <!-- ========================================================= -->

    <panel
        data-user={user.id}
        data-score={score}
        data-enabled={enabled}
        data-status={status}
    >

        <text>{user.name}</text>
        <text>{user.tags.length}</text>
        <text>{pair[0] + pair[1]}</text>
        <text>{result.user.name}</text>
        <text>{nested.result.value}</text>
        <text>{nested.pair[0]}</text>

    </panel>


    <!-- ========================================================= -->
    <!-- 10. ABSOLUTE NIGHTMARE                                   -->
    <!-- ========================================================= -->

    {#each user in users}

        {#each item in user.tags}

            {#each score in items}

                {#each category in categories}

                    <panel>

                        <text>{user.name}</text>

                        <!-- item is actually a tag here -->
                        <text>{item}</text>

                        <!-- score is actually a User here -->
                        <text>{score.name}</text>

                        <text>{category}</text>

                        <!-- globals -->
                        <text>{enabled}</text>
                        <text>{status}</text>
                        <text>{priority}</text>

                        <!-- mixed lexical resolution -->
                        <text>
                            {score.score + user.score}
                        </text>

                        <text>
                            {describe(score)}
                        </text>

                        {#if score.enabled}

                            <text>{score.name}</text>

                            {#each user in users}

                                <text>{user.name}</text>
                                <text>{score.name}</text>
                                <text>{category}</text>
                                <text>{enabled}</text>

                            {/each}

                        {:elif enabled}

                            <text>{user.name}</text>
                            <text>{score.name}</text>

                        {:else}

                            <text>{category}</text>
                            <text>{status}</text>

                        {/if}

                    </panel>

                {/each}

            {/each}

        {/each}

    {/each}

</page>
