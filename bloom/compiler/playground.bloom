<script>
// ============================================================
// GLOBAL TYPE ALIASES
// ============================================================

type UserId = number;

type UserName = string;

type Enabled = boolean;

type Score = number | string;

type Pair = [number, string];

type UserTags = string[];

type StatusValue = "active" | "inactive" | "banned";

type UserRecord = {
    id: UserId;
    name: UserName;
    enabled: Enabled;
    score: Score;
};


// ============================================================
// GLOBAL INTERFACES
// ============================================================

interface User {
    id: UserId;
    name: UserName;
    enabled: Enabled;
    tags: UserTags;
}

interface Config {
    retries: number;
    timeout: number;
    status: StatusValue;
}

interface Result {
    success: boolean;
    value: Score;
    user: User;
}


// ============================================================
// GLOBAL ENUMS
// ============================================================

enum UserStatus {
    Active,
    Inactive,
    Banned,
}

enum Priority {
    Low,
    Medium,
    High,
}


// ============================================================
// GLOBAL STATE USING CUSTOM TYPES
// ============================================================

let currentUser: User = {
    id: 1,
    name: "Bloom",
    enabled: true,
    tags: ["compiler", "ui"],
};

let config: Config = {
    retries: 3,
    timeout: 1000,
    status: "active",
};

let status: UserStatus = UserStatus.Active;

let priority: Priority = Priority.High;

let score: Score = 42;

let pair: Pair = [1, "one"];

let result: Result = {
    success: true,
    value: score,
    user: currentUser,
};

let record: UserRecord = {
    id: 1,
    name: "Bloom",
    enabled: true,
    score: "excellent",
};


// ============================================================
// GLOBAL DIRECTIVES
// ============================================================

#command
function activateUser(user: User): Result {
    currentUser = user;
    currentUser.enabled = true;

    status = UserStatus.Active;

    return {
        success: true,
        value: currentUser.id,
        user: currentUser,
    };
}


#event
function userChanged(user: User, newStatus: UserStatus) {
    currentUser = user;
    status = newStatus;
}


#reactive
function updateScore(value: Score) {
    score = value;
}


// ============================================================
// GLOBAL FUNCTIONS USING CUSTOM TYPES
// ============================================================

function getUser(): User {
    return currentUser;
}


function getConfig(): Config {
    return config;
}


function makeResult(
    user: User,
    value: Score,
): Result {
    return {
        success: true,
        value: value,
        user: user,
    };
}


function updateUser(
    user: User,
    tags: UserTags,
    enabled: Enabled,
) {
    user.tags = tags;
    user.enabled = enabled;

    currentUser = user;
}


function compareScores(
    left: Score,
    right: Score,
): boolean {
    return left === right;
}


function processPair(
    value: Pair,
): Score {
    return value[0];
}


// ============================================================
// LOCAL TYPE ALIASES / INTERFACES / ENUMS
// ============================================================

function localTypesTest() {

    type LocalId = number;

    type LocalName = string;

    type LocalValue = number | boolean;

    type LocalPair = [LocalId, LocalName];

    type LocalTags = string[];

    type LocalRecord = {
        id: LocalId;
        name: LocalName;
        value: LocalValue;
    };


    interface LocalUser {
        id: LocalId;
        name: LocalName;
        enabled: boolean;
        tags: LocalTags;
    }


    interface LocalResult {
        success: boolean;
        user: LocalUser;
        value: LocalValue;
    }


    enum LocalStatus {
        Ready,
        Running,
        Finished,
    }


    enum LocalPriority {
        Low,
        High,
    }


    // --------------------------------------------------------
    // LOCAL VARIABLES USING LOCAL TYPES
    // --------------------------------------------------------

    let id: LocalId = 10;

    let name: LocalName = "local";

    let value: LocalValue = true;

    let tags: LocalTags = ["a", "b"];

    let pair: LocalPair = [id, name];

    let record: LocalRecord = {
        id: id,
        name: name,
        value: value,
    };

    let user: LocalUser = {
        id: id,
        name: name,
        enabled: true,
        tags: tags,
    };

    let localResult: LocalResult = {
        success: true,
        user: user,
        value: value,
    };

    let localStatus: LocalStatus = LocalStatus.Ready;

    let localPriority: LocalPriority = LocalPriority.High;


    // --------------------------------------------------------
    // LOCAL FUNCTION USING LOCAL TYPES
    // --------------------------------------------------------

    function processLocalUser(
        user: LocalUser,
        status: LocalStatus,
        value: LocalValue,
    ): LocalResult {

        user.enabled = true;

        localStatus = status;

        localPriority = LocalPriority.High;

        return {
            success: true,
            user: user,
            value: value,
        };
    }


    // --------------------------------------------------------
    // LOCAL FUNCTION USING GLOBAL TYPES
    // --------------------------------------------------------

    function processGlobalUser(
        user: User,
        config: Config,
    ): Result {

        currentUser = user;

        return {
            success: config.retries > 0,
            value: score,
            user: user,
        };
    }


    // --------------------------------------------------------
    // NESTED SCOPE
    // --------------------------------------------------------

    {
        type NestedValue = string | number;

        interface NestedObject {
            value: NestedValue;
            enabled: boolean;
        }

        enum NestedStatus {
            A,
            B,
        }

        let nestedValue: NestedValue = "nested";

        let nestedObject: NestedObject = {
            value: nestedValue,
            enabled: true,
        };

        let nestedStatus: NestedStatus = NestedStatus.A;

        // Global types still visible.
        let nestedUser: User = currentUser;

        // Outer local types still visible.
        let outerUser: LocalUser = user;

        nestedObject.enabled = outerUser.enabled;

        nestedValue = nestedObject.value;

        localStatus = LocalStatus.Running;
    }


    // Back to function-local types.
    localStatus = LocalStatus.Finished;

    return localResult;
}


// ============================================================
// SHADOWING CUSTOM TYPES
// ============================================================

function shadowedTypes() {

    type Value = number;

    interface Data {
        value: Value;
    }

    enum State {
        One,
        Two,
    }

    let value: Value = 10;

    let data: Data = {
        value: value,
    };

    let state: State = State.One;


    {
        type Value = string;

        interface Data {
            value: Value;
        }

        enum State {
            Inner,
        }

        let value: Value = "inner";

        let data: Data = {
            value: value,
        };

        let state: State = State.Inner;

        // Global custom types remain visible.
        let user: User = currentUser;

        message = user.name;
    }


    // Back to outer local types.
    value = 20;

    data.value = value;

    state = State.Two;
}


// ============================================================
// MIXED GLOBAL + LOCAL CUSTOM TYPES
// ============================================================

function everything(
    user: User,
    result: Result,
    pair: Pair,
    score: Score,
) {

    type LocalScore = number | string;

    interface LocalConfig {
        retries: number;
        score: LocalScore;
        user: User;
    }

    enum LocalState {
        Idle,
        Running,
        Done,
    }


    let localScore: LocalScore = score;

    let localConfig: LocalConfig = {
        retries: config.retries,
        score: localScore,
        user: user,
    };

    let localState: LocalState = LocalState.Idle;


    #reactive
    function updateLocal(
        config: LocalConfig,
        state: LocalState,
    ) {
        localConfig = config;
        localState = state;

        currentUser = config.user;
    }


    #command
    function finish(
        value: LocalScore,
    ): Result {
        localScore = value;
        localState = LocalState.Done;

        return {
            success: true,
            value: value,
            user: currentUser,
        };
    }


    if (localConfig.retries > 0) {
        localState = LocalState.Running;

        updateLocal(
            localConfig,
            localState,
        );
    }


    return finish(localScore);
}


// ============================================================
// TYPE REFERENCES THROUGH FUNCTIONS / CALLBACKS
// ============================================================

function callbackTest() {

    type CallbackValue = User | Result;

    interface CallbackData {
        value: CallbackValue;
        priority: Priority;
    }


    let data: CallbackData = {
        value: currentUser,
        priority: priority,
    };


    const callback = (
        value: CallbackValue,
    ): CallbackValue => {

        if (typeof value === "object") {
            return value;
        }

        return value;
    };


    data.value = callback(data.value);

    return data;
}


// ============================================================
// DEEPLY NESTED TYPE REFERENCES
// ============================================================

function deeplyNested() {

    type OuterValue = number | string;

    interface Outer {
        value: OuterValue;
    }


    let outer: Outer = {
        value: 10,
    };


    {
        type MiddleValue = boolean;

        interface Middle {
            value: MiddleValue;
        }

        let middle: Middle = {
            value: true,
        };


        {
            type InnerValue = [OuterValue, MiddleValue];

            interface Inner {
                value: InnerValue;
                outer: Outer;
                middle: Middle;
            }

            let inner: Inner = {
                value: [outer.value, middle.value],
                outer: outer,
                middle: middle,
            };

            outer.value = inner.value[0];
            middle.value = inner.value[1];
        }
    }
}


// ============================================================
// GLOBAL DIRECTIVES USING LOCAL / GLOBAL TYPE REFERENCES
// ============================================================

#command
function commandWithTypes(
    user: User,
    priority: Priority,
): Result {

    status = UserStatus.Active;

    return makeResult(
        user,
        priority === Priority.High
            ? 100
            : "normal",
    );
}


#event
function eventWithTypes(
    result: Result,
    user: User,
) {
    currentUser = user;
    score = result.value;
}


#reactive
function reactiveWithTypes(
    config: Config,
    user: User,
) {
    currentUser = user;

    if (config.retries > 0) {
        currentUser.enabled = true;
    }
}


// ============================================================
// TOP LEVEL USE
// ============================================================

let finalUser: User = getUser();

let finalConfig: Config = getConfig();

let finalResult: Result = makeResult(
    finalUser,
    score,
);

let finalPair: Pair = [finalUser.id, finalUser.name];

let finalRecord: UserRecord = record;

activateUser(finalUser);

userChanged(
    finalUser,
    UserStatus.Inactive,
);

updateScore(finalResult.value);

commandWithTypes(
    finalUser,
    Priority.High,
);

eventWithTypes(
    finalResult,
    finalUser,
);

reactiveWithTypes(
    finalConfig,
    finalUser,
);
</script>
