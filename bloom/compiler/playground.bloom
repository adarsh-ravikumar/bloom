<!-- ============================================================
     1. TOP-LEVEL TEXT / WHITESPACE
     ============================================================ -->

hello
world

plain text with punctuation ! @ # $ % ^ & * ( ) [ ] = + - _ .


<!-- ============================================================
     2. SIMPLE ELEMENTS
     ============================================================ -->

<div></div>

<br />

<input disabled />

<section id="main" class="container" data-value="hello">
    content
</section>


<!-- ============================================================
     3. IDENTIFIER VARIANTS
     ============================================================ -->

<my-component></my-component>

<foo-bar></foo-bar>

<_private></_private>

<component123></component123>

<div data-id_123="test"></div>


<!-- ============================================================
     4. ATTRIBUTES
     ============================================================ -->

<div
    disabled
    hidden
    autofocus
    class="container"
    id="main"
    data-value="hello"
    aria-label="hello world"
></div>

<div
    title="hello {user.name}"
    class="{theme.className}"
    data-value={user.id}
    aria-label="{label}"
></div>

<div
    title="hello {user.name} {user.profile.name}"
    data-value={foo({
        a: 1,
        b: "}",
        c: {
            nested: true
        }
    })}
></div>


<!-- ============================================================
     5. TEXT + EXPRESSIONS
     ============================================================ -->

<p>Hello {user.name}!</p>

<p>
    Hello
    {user.firstName}
    {user.lastName}
    !
</p>

<p>{foo()}</p>

<p>{foo(bar)}</p>

<p>{foo({ a: 1, b: [1, 2, 3] })}</p>

<p>{user?.profile?.name ?? "Anonymous"}</p>

<p>{condition ? "yes" : "no"}</p>


<!-- ============================================================
     6. QUOTED ATTRIBUTE PARTS
     ============================================================ -->

<div
    class="prefix-{user.name}-suffix"
    title="{foo()} {bar()} static"
    data-test="hello {user.name} {user.id} world"
    aria-label='hello {user.name} world'
></div>


<!-- ============================================================
     7. EMBEDDED JS STRESS
     ============================================================ -->

<div
    data-value={foo({
        user: user,
        metadata: {
            source: "profile } page",
            nested: [
                { value: "}" },
                { value: '}' },
                { deeper: { value: "still } a string" } }
            ]
        }
    })}
>
    {
        foo(
            bar(
                baz({
                    a: [1, 2, 3],
                    b: { x: "{", y: "}" },
                    c: "hello"
                })
            )
        )
    }
</div>

<p>
    {`simple template`}
    {`template with } braces`}
    {`template ${user.name}`}
    {`template ${foo({ value: "}" })}`}
    {`outer ${`inner ${foo({ x: "}" })}`} tail`}
</p>


<!-- ============================================================
     8. COMMENTS
     ============================================================ -->

<!-- simple comment -->

<!--
    multiline comment
-->

<div>
    <!-- comment between elements -->
    <span>hello</span>
    <!-- another comment -->
</div>


<!-- ============================================================
     9. IF / ELIF / ELSE — TOP LEVEL
     ============================================================ -->

{#if user.isAdmin}
    Admin
{:elif user.isModerator}
    Moderator
{:elif user.isStaff}
    Staff
{:else}
    User
{/if}


<!-- ============================================================
     10. IF — NO ELSE / NO ELIF
     ============================================================ -->

{#if user.isLoggedIn}
    Welcome back!
{/if}


<!-- ============================================================
     11. IF / ELIF / ELSE — INSIDE ELEMENT
     ============================================================ -->

<div class="account">
    <h1>{user.name}</h1>

    {#if user.isPremium}
        <span class="badge">Premium</span>
    {:elif user.isTrial}
        <span class="badge">Trial</span>
    {:else}
        <span class="badge">Free</span>
    {/if}
</div>


<!-- ============================================================
     12. NESTED CONTROL BLOCKS
     ============================================================ -->

{#if user.loggedIn}
    <section>

        {#if user.isAdmin}
            <p>Admin</p>
        {:elif user.isModerator}
            <p>Moderator</p>
        {:else}
            <p>User</p>
        {/if}

    </section>
{:elif user.isGuest}
    <p>Guest</p>
{:else}
    <p>Please log in</p>
{/if}


<!-- ============================================================
     13. CONTROL INSIDE CONTROL INSIDE ELEMENT
     ============================================================ -->

{#if app.ready}
    <main>

        {#if user}
            <div class="user">

                {#if user.profile}
                    <section>
                        <h2>{user.profile.name}</h2>
                    </section>
                {:elif user.loading}
                    <span>Loading...</span>
                {:else}
                    <span>No profile</span>
                {/if}

            </div>
        {:elif app.loading}
            <p>Loading user...</p>
        {:else}
            <p>No user</p>
        {/if}

    </main>
{:else}
    <p>Application unavailable.</p>
{/if}


<!-- ============================================================
     14. EACH
     ============================================================ -->

{#each users in users}
    <p>{users.name}</p>
{/each}


{#each user in users}
    <div class="user">
        <span>{user.name}</span>
    </div>
{/each}


<!-- ============================================================
     15. EACH WITH COMPLEX EXPRESSION
     ============================================================ -->

{#each user in users.filter(user => user.active)}
    <p>{user.name}</p>
{/each}


{#each item in items.map(item => ({
    id: item.id,
    name: item.name,
    value: item.value
}))}
    <div>{item.name}</div>
{/each}


<!-- ============================================================
     16. EACH NESTED IN IF
     ============================================================ -->

{#if users.length > 0}
    <ul>
        {#each user in users}
            <li>
                {user.name}

                {#if user.isAdmin}
                    <strong>Admin</strong>
                {:elif user.isModerator}
                    <strong>Moderator</strong>
                {:else}
                    <span>User</span>
                {/if}
            </li>
        {/each}
    </ul>
{:else}
    <p>No users.</p>
{/if}


<!-- ============================================================
     17. IF NESTED IN EACH
     ============================================================ -->

{#each item in items}
    {#if item.visible}
        <article>
            <h2>{item.title}</h2>
            <p>{item.description}</p>
        </article>
    {:else}
        <span>Hidden</span>
    {/if}
{/each}


<!-- ============================================================
     18. DEEPLY NESTED ELEMENTS
     ============================================================ -->

<div class="root">
    <main>
        <section>
            <article>
                <header>
                    <div>
                        <span>
                            <strong>
                                Deeply nested text
                            </strong>
                        </span>
                    </div>
                </header>
            </article>
        </section>
    </main>
</div>


<!-- ============================================================
     19. DEEPLY NESTED ELEMENT + CONTROL + EXPRESSIONS
     ============================================================ -->

<div class="application">
    <main>
        {#if application.ready}
            <section class="content">

                {#each section in application.sections}
                    <article class={section.className}>

                        <header>
                            <h2>{section.title}</h2>
                        </header>

                        {#if section.items.length > 0}
                            <div class="items">

                                {#each item in section.items}
                                    <div class="item">
                                        <span>{item.name}</span>

                                        {#if item.active}
                                            <strong>Active</strong>
                                        {:elif item.pending}
                                            <strong>Pending</strong>
                                        {:else}
                                            <strong>Inactive</strong>
                                        {/if}
                                    </div>
                                {/each}

                            </div>
                        {:else}
                            <p>No items.</p>
                        {/if}

                    </article>
                {/each}

            </section>
        {:else}
            <section>
                <p>Loading...</p>
            </section>
        {/if}
    </main>
</div>


<!-- ============================================================
     20. SELF CLOSING ELEMENTS AROUND EVERYTHING
     ============================================================ -->

<div>
    <input disabled />
    <input class="field" value={user.name} />
    <br />
    <hr />
    <custom-component
        foo="bar"
        value={foo()}
        class="{thing}"
    />
</div>


<!-- ============================================================
     21. BOOLEAN + EXPRESSION + QUOTED + MIXED ATTRIBUTES
     ============================================================ -->

<button
    disabled
    autofocus
    class="button {theme.className}"
    id={button.id}
    title="Click {user.name}"
    data-state={state.current}
    aria-label="{label}"
    onclick={() => handleClick({
        user: user,
        metadata: {
            source: "button } handler",
            nested: [{ value: "}" }, { value: '}' }]
        }
    })}
>
    Click me
</button>


<!-- ============================================================
     22. EVERYTHING AT ONCE
     ============================================================ -->

{#if application.ready}

    <div
        class="application {theme.className}"
        data-id={application.id}
        title="Application: {application.name}"
    >

        {#each section in application.sections}

            <section class={section.className}>

                <header>
                    <h2>{section.title}</h2>

                    {#if section.visible}
                        <span>Visible</span>
                    {:elif section.loading}
                        <span>Loading</span>
                    {:else}
                        <span>Hidden</span>
                    {/if}
                </header>

                {#if section.items.length > 0}

                    {#each item in section.items.filter(item => item.active)}

                        <article
                            id={item.id}
                            class="item {item.className}"
                            data-value={foo({
                                item: item,
                                text: "}",
                                nested: {
                                    value: "{"
                                }
                            })}
                        >

                            <h3>{item.name}</h3>

                            <p>
                                {item.description ?? "No description"}
                            </p>

                            {#if item.featured}
                                <strong>Featured</strong>
                            {:elif item.pending}
                                <strong>Pending</strong>
                            {:else}
                                <span>Standard</span>
                            {/if}

                        </article>

                    {/each}

                {:else}

                    <p>No items in {section.name}.</p>

                {/if}

            </section>

        {/each}

    </div>

{:elif application.loading}

    <div class="loading">
        <span>Loading application...</span>
    </div>

{:else}

    <div class="error">
        <h1>Application unavailable</h1>
        <p>{application.error ?? "Unknown error"}</p>
    </div>

{/if}
